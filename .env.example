# Create .env from this file. Never commit a real key.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Docker Compose overrides this to the qdrant service. Use a Qdrant Cloud URL on AWS.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledgeops

CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=60
MAX_AGENT_TURNS=4
LOG_LEVEL=INFO

